# BillForBill Backend — Environment Variables
# Copy this file to .env and replace the values below with your real configuration.
# Never commit .env to version control.

# HTTPS port the Express server listens on
PORT=3000

# local: Express loads the localhost certificate below.
# proxy: Azure terminates public TLS and forwards requests to this app.
TLS_MODE=local

# HTTPS certificate files for localhost (used only when TLS_MODE=local).
# Install a locally trusted development certificate (for example with mkcert)
# and keep the private key in the ignored repository-root certs/ directory.
TLS_KEY_PATH=../certs/localhost-key.pem
TLS_CERT_PATH=../certs/localhost.pem

# Angular origin(s) allowed to make credentialed API calls. In local mode,
# localhost and 127.0.0.1 are treated as aliases on the configured port.
FRONTEND_ORIGIN=https://localhost:4200
# For multiple deployed frontend origins, use a comma-separated FRONTEND_ORIGINS value.

# Generate a random secret of at least 32 characters; do not commit the real value.
OTP_HASH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Session lifetime; MongoDB expiry and cookie expiry use the same value.
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_NAME=billforbill_session

# OTP lifetime is capped by the application at 300 seconds (5 minutes).
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_REQUEST_LIMIT_PHONE_PER_HOUR=5
OTP_REQUEST_LIMIT_IP_PER_HOUR=20

# MongoDB connection string
# Format: mongodb://<host>:<port>/<database>
# For a local MongoDB instance without authentication:
#   mongodb://localhost:27017/billforbill
# For a local instance with auth:
#   mongodb://username:password@localhost:27017/billforbill
MONGODB_URI=mongodb://localhost:27017/billforbill

# Default business-local timezone used for monthly plan limits when a business
# record has no timeZone value. Use a valid IANA timezone name.
BUSINESS_DEFAULT_TIME_ZONE=Asia/Kolkata

# Background workbook jobs use a separate database and GridFS bucket.
# When omitted, the API and worker reuse MONGODB_URI with this database name.
# The API and worker must use matching MONGODB_JOBS_URI and MONGODB_JOBS_DB values.
# Both services need access to MONGODB_URI; the API also needs access to the jobs database.
# In production, set MONGODB_JOBS_URI to use a separate MongoDB deployment if desired.
MONGODB_JOBS_DB=billforbill_jobs
# MONGODB_JOBS_URI=mongodb://localhost:27017/billforbill_jobs
